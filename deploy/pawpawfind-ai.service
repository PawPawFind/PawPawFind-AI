[Unit]
Description=PawPawFind AI (FastAPI uvicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/PawPawFind-AI
Environment=PATH=/home/ec2-user/.local/bin:/usr/local/bin:/usr/bin
Environment=GALLERY_CACHE_ROOT=/home/ec2-user/PawPawFind-AI/cache/gallery
Environment=PAWPAWFIND_MATCH_MODE=real
Environment=PAWPAWFIND_GALLERY_SOURCE=rds
Environment=PAWPAWFIND_BACKEND_URL=http://127.0.0.1:8080
Environment=MATCH_TOP_K=20
ExecStart=/home/ec2-user/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=10
StandardOutput=append:/home/ec2-user/logs/ai.log
StandardError=append:/home/ec2-user/logs/ai.error.log

[Install]
WantedBy=multi-user.target
